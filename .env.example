# SGRC Backend — variables de entorno (plantilla — copiar a .env y editar)

# MySQL 8 (local o gestionado). En producción añade el pool: ?connection_limit=20&pool_timeout=20
DATABASE_URL="mysql://root:REEMPLAZAR_PASSWORD@localhost:3306/sgrc"

# JWT
JWT_SECRET="cambiar-este-secret-en-produccion-min-32-caracteres-aleatorios"
JWT_EXPIRES_IN="8h"
REFRESH_SECRET="otro-secret-distinto-para-refresh-tokens"
REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=development

# CORS
FRONTEND_ORIGIN="http://localhost:5173,http://localhost:5174"

# Notificaciones (vacío en dev → se omiten)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SGRC <noreply@cofca.co>"

# Buzones institucionales de Dirección Médica (copia informativa de ausencias).
# Lista separada por comas. Vacío = usa los 2 buzones por defecto en código.
EMAIL_DIRECCION_MEDICA="secretariadirmedica@cofca.com,direccionmedica@cofca.com"

WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_FROM=""
# Canal WhatsApp desactivado por defecto (proveedor no contratado).
# Cambiar a "true" solo cuando se tenga proveedor activo + credenciales arriba.
WHATSAPP_NOTIFY_ENABLED=false

# ── MODO TEMPORAL: PROGRAMACIÓN LIBRE ────────────────────────────────────────
# true  = los coordinadores pueden programar semanas ya vencidas y sedes cuyo
#         cierre semanal ya se procesó. Sirve para cuadres retroactivos (cargar
#         el mes pasado). El auto-cierre nocturno queda en pausa mientras dure.
#         El arranque lo avisa por consola en grande.
# false = comportamiento normal (es el defecto si la variable no está).
#
# SIGUE VALIDÁNDOSE: solapes de recurso y auxiliar, una ciudad por día, tope
# diario de horas, permisos por rol y auditoría. Esto solo levanta el calendario.
#
# Para volver a la normalidad: poner false (o borrar la línea) y reiniciar.
PROGRAMACION_LIBRE=false

# Jobs automáticos (cron). Viven dentro del proceso web, así que con VARIAS
# réplicas se ejecutarían por duplicado: dos resúmenes diarios a cada recurso,
# dos auto-cierres de semana. Al escalar, dejar "true" en UNA sola instancia
# (o en ninguna, y levantar un proceso aparte solo para jobs).
JOBS_ENABLED=true

# Retención del log de auditoría, en meses. La purga corre los domingos a las
# 3am. Ajustar al plazo legal que aplique a la clínica. 0 = no purgar nunca.
AUDITORIA_RETENCION_MESES=24

# Rate limiting
# LOGIN: intentos FALLIDOS por cuenta (email) en 15 min — los logins correctos no cuentan.
# GLOBAL: peticiones por minuto por usuario (token), no por IP — soporta NAT corporativo.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_GLOBAL=600
